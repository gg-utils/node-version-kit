{
  "name": "@gg-utils/node-version-kit",
  "version": "0.2.0",
  "description": "Reusable node-version parity UI helpers and terminal shells.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./format-commands": {
      "types": "./dist/format-commands.d.ts",
      "default": "./dist/format-commands.js"
    },
    "./ink-app": {
      "types": "./dist/ink-app.d.ts",
      "default": "./dist/ink-app.js"
    },
    "./opentui-app": {
      "types": "./dist/opentui-app.d.ts",
      "default": "./dist/opentui-app.js"
    },
    "./report-rows": {
      "types": "./dist/report-rows.d.ts",
      "default": "./dist/report-rows.js"
    },
    "./package.json": "./package.json",
    "./opentui-runtime/jsx-runtime": {
      "types": "./dist/opentui-runtime/jsx-runtime.d.ts",
      "default": "./dist/opentui-runtime/jsx-runtime.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.unit.test.ts src/*.unit.test.tsx",
    "lint": "eslint src --max-warnings 0",
    "check:dist": "npm run build && git diff --exit-code -- dist && node scripts/check-dist-untracked.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/node-version-kit.git"
  },
  "dependencies": {
    "ink": "6.8.0",
    "react": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
