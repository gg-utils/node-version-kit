{
  "name": "@gg-utils/node-version-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable node-version parity UI helpers and terminal shells.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./format-commands": {
      "types": "./src/format-commands.ts",
      "default": "./src/format-commands.ts"
    },
    "./ink-app": {
      "types": "./src/ink-app.tsx",
      "default": "./src/ink-app.tsx"
    },
    "./opentui-app": {
      "types": "./src/opentui-app.tsx",
      "default": "./src/opentui-app.tsx"
    },
    "./report-rows": {
      "types": "./src/report-rows.ts",
      "default": "./src/report-rows.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.unit.test.ts",
    "README.md",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "engines": {
    "node": ">=24.11.1 <25",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "type-check": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "node ../../node_modules/tsx/dist/cli.mjs --test \"src/**/*.unit.test.ts\" \"src/**/*.unit.test.tsx\""
  }
}
